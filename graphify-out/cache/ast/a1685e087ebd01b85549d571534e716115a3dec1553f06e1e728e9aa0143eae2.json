allbackAfterWorker(path, fallbackData) && isWuWaStatsPath(path)) {\n                console.warn(`[Bot API] Vercel returned empty WuWa stats for ${path}. Retrying once after warmup delay.`);\n                await wait(2500);\n                const retryPath = appendCacheBust(path);\n                const retryResponse = await fetchWithTimeout(`${VERCEL_API_URL}/api${retryPath}`, timeouts.fallback, {\n                    headers: { Accept: 'application/json' },\n                });\n                const retryData = await fetchJson(retryResponse);\n                if (hasUsableFiveStarStats(retryData)) {\n                    fallbackData = retryData;\n                }\n            }\n\n            if (!shouldFallbackAfterWorker(path, fallbackData)) {\n                writeCache(cacheKey, fallbackData);\n            }\n            return fallbackData;\n        } catch (fallbackError) {\n            if (fallbackError.name === 'AbortError') {\n                throw new Error(`Vercel fallback timed out after ${timeouts.fallback}ms for ${path}`);\n            }\n            throw fallbackError;\n        }\n    })", "source_file": "D:\\Coding\\HSR_PatternRecord\\discord-bot\\utils\\botWarpService.js", "source_location": "L137"}, {"caller_nid": "utils_botwarpservice_fetchhotapi", "callee": "set", "source_file": "D:\\Coding\\HSR_PatternRecord\\discord-bot\\utils\\botWarpService.js", "source_location": "L193"}, {"caller_nid": "utils_botwarpservice_fetchlivebanners", "callee": "error", "source_file": "D:\\Coding\\HSR_PatternRecord\\discord-bot\\utils\\botWarpService.js", "source_location": "L203"}, {"caller_nid": "utils_botwarpservice_fetchwarpstats", "callee": "warn", "source_file": "D:\\Coding\\HSR_PatternRecord\\discord-bot\\utils\\botWarpService.js", "source_location": "L227"}, {"caller_nid": "utils_botwarpservice_fetchwarpstats", "callee": "encodeURIComponent", "source_file": "D:\\Coding\\HSR_PatternRecord\\discord-bot\\utils\\botWarpService.js", "source_location": "L23