{
  "version": 2,
  "framework": "vite",
  "installCommand": "npm install",
  "devCommand": "npx vite --host 0.0.0.0 --port $PORT",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Cache-Control, x-api-key, Authorization, X-Requested-With, Pragma"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/hoyo-codes",
      "destination": "/api/game-proxy?route=hoyo-codes"
    },
    {
      "source": "/api/hsr/:slug*",
      "destination": "/api/hsr"
    },
    {
      "source": "/api/wuwa/:slug*",
      "destination": "/api/game-proxy"
    },
    {
      "source": "/api/genshin/:slug*",
      "destination": "/api/game-proxy"
    },
    {
      "source": "/api/zone/:slug*",
      "destination": "/api/zone"
    },
    {
      "source": "/api/admin-users",
      "destination": "/api/admin?action=users"
    },
    {
      "source": "/api/admin-users/:path*",
      "destination": "/api/admin?action=users"
    }
  ],
  "crons": [
    {
      "path": "/api/hsr/cron-wipe",
      "schedule": "0 6 * * 1"
    }
  ]
}
