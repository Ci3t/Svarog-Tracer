{
  "version": 2,
  "framework": "vite",
  "installCommand": "npm install",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Cache-Control, x-api-key, Authorization" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/hsr/cron-wipe",
      "schedule": "0 4 * * 1"
    }
  ]
}
